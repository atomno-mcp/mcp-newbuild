# Учётка договора API ЕИСЖС (ваш договор-оферта на бизнес.дом.рф).
# MCP_NEWBUILD_EISZHS_CLIENT_ID=
# MCP_NEWBUILD_EISZHS_CLIENT_SECRET=
# MCP_NEWBUILD_EISZHS_BASE_URL=
# MCP_NEWBUILD_EISZHS_TOKEN_URL=

# Наше размещение — отдельная услуга, не ключ ЕИСЖС.
# MCP_NEWBUILD_API_KEY=

# Необязательно:
# MCP_NEWBUILD_API_BASE=https://api.atomno-mcp.ru/newbuild
# MCP_NEWBUILD_TIMEOUT=30
# MCP_NEWBUILD_LOG_LEVEL=INFO
